OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional override. The livestream currently falls back to the bundled Stripe test publishable key.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Option A: one Cloudflare base URL. File names are defined in aria_chat_server.mjs and netlify/functions/api.mjs.
CLOUDFLARE_DOWNLOAD_BASE_URL=https://your-cloudflare-domain.com/products
R2_FILE_KEY=Door Knocking Script.zip
R2_FILE_KEY2=How to get roofing leads.zip

# Option B: override individual product download URLs.
# DOWNLOAD_URL_DOOR_KNOCKING_SCRIPT=
# DOWNLOAD_URL_ROOFING_LEADS=
